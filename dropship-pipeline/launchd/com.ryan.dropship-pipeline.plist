<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ryan.dropship-pipeline</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ryannortham/MyVault/dropship-pipeline/run-pipeline.sh</string>
  </array>

  <!-- Runs at 7:00 AM daily -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Also fires on login/load, in case the Mac was asleep at 7am.
       The script itself checks a marker file so this won't double-run. -->
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/ryannortham/MyVault/dropship-pipeline/logs/launchd-stdout.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/ryannortham/MyVault/dropship-pipeline/logs/launchd-stderr.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/Users/ryannortham/.npm-global/bin</string>
  </dict>
</dict>
</plist>
